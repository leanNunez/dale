    "ToolCalled": {
      "additionalProperties": false,
      "description": "One tool call of a turn. `name` and `summary` are model-controlled text.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 64,
          "title": "Name",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 200,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary",
        "ok",
        "code"
      ],
      "title": "ToolCalled",
      "type": "object"
    },
    "ToolCalledEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ToolCalled"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
