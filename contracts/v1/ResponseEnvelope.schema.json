        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "enum": [
            "verified",
            "mismatch",
            "missing",
            "unexpected_write"
          ],
          "title": "Kind",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order Id"
        },
        "proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposal Id"
        }
      },
      "required": [
        "kind",
        "proposal_id",
        "order_id",
        "fields"
      ],
      "title": "Finding",
      "type": "object"
    },
