        "v",
        "seq",
        "conversation_id",
        "type",
        "data"
      ],
      "title": "ToolCalledEvent",
      "type": "object"
    },
    "VerdictIssued": {
      "additionalProperties": false,
      "properties": {
        "false_confirmations": {
          "minimum": 0,
          "title": "False Confirmations",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "reason": {
          "enum": [
            "",
            "timeout",
            "spawn_failed",
            "malformed_output",
            "bad_request",
            "no_database_url",
            "unknown",
            "verifier_error"
          ],
          "title": "Reason",
          "type": "string"
        },
        "stored_orders": {
          "items": {
            "$ref": "#/$defs/StoredOrder"
          },
          "title": "Stored Orders",
          "type": "array"
        },
        "subject_proposal_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Proposal Id"
        },
        "unexpected_writes": {
          "minimum": 0,
          "title": "Unexpected Writes",
          "type": "integer"
        },
        "verdict": {
          "enum": [
            "verified",
            "mismatch",
            "missing",
            "unexpected_write",
            "nothing_confirmed",
            "unverifiable"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "subject_proposal_id",
        "verdict",
        "reason",
        "false_confirmations",
        "unexpected_writes",
        "findings",
        "stored_orders"
      ],
      "title": "VerdictIssued",
      "type": "object"
    },
    "VerdictIssuedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/VerdictIssued"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "VerdictIssued",
          "default": "VerdictIssued",
