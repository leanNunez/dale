      "required": [
        "v",
        "seq",
        "conversation_id",
        "type",
        "data"
      ],
      "title": "AssistantTextEvent",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebErrorCode"
            },
            {
              "$ref": "#/$defs/ErrorCode"
            }
          ],
          "title": "Code"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
