      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "customer_not_found",
        "product_not_found",
        "price_not_available",
        "invalid_quantity",
        "below_minimum_amount",
        "no_delivery_slot",
        "ungrounded_product",
        "proposal_not_found",
        "proposal_not_pending",
        "price_changed",
        "delivery_date_changed",
        "rules_unavailable",
        "turn_limit_reached",
        "model_refusal",
        "model_unavailable",
        "turn_deadline_exceeded",
        "unknown_tool",
        "invalid_tool_input"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
