      "type": "object"
    },
    "WebErrorCode": {
      "enum": [
        "invalid_host",
        "forbidden_origin",
        "unsupported_media_type",
        "payload_too_large",
        "invalid_request",
        "not_found",
        "method_not_allowed",
        "conversation_not_found",
        "conversation_busy",
        "turn_failed",
        "confirm_outcome_unknown",
        "internal_error"
      ],
      "title": "WebErrorCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Every API response. `seq` is the conversation's last event seq when it was built.",
  "properties": {
    "conversation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conversation Id"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "AssistantText": "#/$defs/AssistantTextEvent",
            "HandoffNotice": "#/$defs/HandoffNoticeEvent",
            "OrderConfirmed": "#/$defs/OrderConfirmedEvent",
            "OrderRejected": "#/$defs/OrderRejectedEvent",
            "ProposalSummary": "#/$defs/ProposalSummaryEvent",
            "SystemNotice": "#/$defs/SystemNoticeEvent",
            "ToolCalled": "#/$defs/ToolCalledEvent",
            "VerdictIssued": "#/$defs/VerdictIssuedEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AssistantTextEvent"
          },
          {
            "$ref": "#/$defs/ProposalSummaryEvent"
          },
          {
            "$ref": "#/$defs/OrderConfirmedEvent"
          },
          {
            "$ref": "#/$defs/OrderRejectedEvent"
          },
          {
            "$ref": "#/$defs/HandoffNoticeEvent"
          },
          {
            "$ref": "#/$defs/SystemNoticeEvent"
          },
          {
            "$ref": "#/$defs/ToolCalledEvent"
          },
          {
            "$ref": "#/$defs/VerdictIssuedEvent"
          }
        ]
      },
      "title": "Events",
      "type": "array"
    },
    "pending_proposal_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Proposal Id"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "v": {
      "const": 1,
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "conversation_id",
    "seq",
    "events",
    "pending_proposal_id",
    "error"
  ],
  "title": "ResponseEnvelope",
  "type": "object"
}
